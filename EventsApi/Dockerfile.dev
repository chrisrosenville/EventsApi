FROM mcr.microsoft.com/dotnet/sdk:9.0 AS dev
WORKDIR /app

# Copy the project file and restore dependencies
COPY ["EventsApi/EventsApi.csproj", "EventsApi/"]
RUN dotnet restore "EventsApi/EventsApi.csproj"

# Copy everything else
COPY . .

# Set working directory to the project directory
WORKDIR "/app/EventsApi"

# Set environment variables
ENV ASPNETCORE_ENVIRONMENT=Development
ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_USE_POLLING_FILE_WATCHER=1

# Expose port
EXPOSE 8080

# Use dotnet watch for hot reload
ENTRYPOINT ["dotnet", "watch", "--project", "EventsApi.csproj", "run", "--no-launch-profile"]